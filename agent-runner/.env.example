# Placeholders only. Never commit real values.
APP_URL=https://your-app.example.com
# Optional: instead of `python -m runner pair`, provide the token issued at pairing.
AGENT_RUNNER_TOKEN=
AGENT_RUNNER_ID=
# Folders the agent may use (comma-separated). Never your home folder or system folders.
APPROVED_WORKSPACE_ROOTS=~/AI-Projects
MAX_TOOL_EXECUTION_SECONDS=120
MAX_COMMAND_OUTPUT_BYTES=200000
MAX_WEB_FETCH_BYTES=3000000
MAX_WEB_FETCH_REDIRECTS=5
MAX_FILE_READ_BYTES=400000
MAX_RUNNING_DEV_SERVERS_PER_WORKSPACE=2
# MAX_AGENT_STEPS is enforced by the app (default 20, cap 30).
# The CodeCraft key stays in the app's encrypted connection and is NEVER given to the runner.
